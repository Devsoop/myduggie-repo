{{ 'reviews-components.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style reviews-surface reviews-surface--status section-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="reviews-status-page">
    <div class="reviews-status-card reviews-status-card--thank-you">
      <svg class="reviews-status-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
      <h1 class="reviews-status-card__heading">Thank you.</h1>
      <p class="reviews-status-card__body">
        Somewhere, someone is about to read this and be glad you wrote it.
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Review thank you",
  "tag": "section",
  "class": "reviews-section-thank-you",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "select", "id": "section_width", "label": "t:settings.section_width", "default": "page-width", "options": [
      { "value": "page-width", "label": "Page width" },
      { "value": "full-width", "label": "Full width" }
    ]},
    { "type": "range", "id": "padding-block-start", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding-block-end", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "presets": [{ "name": "Review thank you" }]
}
{% endschema %}
