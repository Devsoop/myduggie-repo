{{ 'reviews-components.css' | asset_url | stylesheet_tag }}
<script src="{{ 'reviews-link-inactive.js' | asset_url }}" defer></script>

{%- comment -%}
  §5.5b — M3: App Proxy sets reviews_link_state cookie (expired|used) before redirect.
  Theme editor Preview state still works for QA when cookie absent.
{%- endcomment -%}

{%- liquid
  assign link_state = 'expired'
  assign preview_state = section.settings.preview_state | strip

  if preview_state == 'used' or preview_state == 'expired'
    assign link_state = preview_state
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style reviews-surface reviews-surface--status section-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-reviews-link-inactive
  data-preview-state="{{ link_state }}"
>
  <div class="reviews-status-page">
    <div data-reviews-status-used hidden>
      {% render 'review-status-card', link_state: 'used' %}
    </div>
    <div data-reviews-status-expired>
      {% render 'review-status-card', link_state: 'expired' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Review link inactive",
  "tag": "section",
  "class": "reviews-section-link-inactive",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Preview (theme editor)"
    },
    {
      "type": "select",
      "id": "preview_state",
      "label": "Preview state (editor QA)",
      "options": [
        { "value": "", "label": "Expired (default)" },
        { "value": "expired", "label": "Expired" },
        { "value": "used", "label": "Already submitted" }
      ],
      "default": ""
    },
    {
      "type": "paragraph",
      "content": "Production: App Proxy sets reviews_link_state cookie. Theme editor uses Preview state when cookie is absent."
    }
  ],
  "presets": [
    {
      "name": "Review link inactive"
    }
  ]
}
{% endschema %}
