{%- liquid
  assign p1 = "Someone gave you one. You've held it, so now you know what it actually feels like in your hand. The next person reading this might be choosing it for someone — the way it was chosen for you. Your story is what they need."
  assign p2 = "A few questions, a few sentences if you have them, photos if you took any — about ninety seconds. Your review will help the next person decide. Thank you for taking the time."
-%}

{%- capture form_fields -%}
  <div class="reviews-form__dropdowns">
    <div class="reviews-form__field">
      <label class="reviews-form__label" for="how_often-{{ section.id }}">How often you use it</label>
      <select id="how_often-{{ section.id }}" name="how_often" data-reviews-required>
        <option value="">Select…</option>
        <option value="Daily">Daily</option>
        <option value="Weekly">Weekly</option>
        <option value="Occasionally">Occasionally</option>
      </select>
      <p class="reviews-form__error" data-error-for="how_often" hidden></p>
    </div>
    <div class="reviews-form__field">
      <label class="reviews-form__label" for="where_it_lives-{{ section.id }}">Where it lives</label>
      <select id="where_it_lives-{{ section.id }}" name="where_it_lives" data-reviews-required>
        <option value="">Select…</option>
        <option value="Pocket">Pocket</option>
        <option value="Bag">Bag</option>
        <option value="Home">Home</option>
      </select>
      <p class="reviews-form__error" data-error-for="where_it_lives" hidden></p>
    </div>
    <div class="reviews-form__field">
      <label class="reviews-form__label" for="dugout_experience-{{ section.id }}">Dugout experience</label>
      <select id="dugout_experience-{{ section.id }}" name="dugout_experience" data-reviews-required>
        <option value="">Select…</option>
        <option value="Dugout veteran">Dugout veteran (used dugouts before)</option>
        <option value="Dugout rookie">Dugout rookie (first time)</option>
      </select>
      <p class="reviews-form__error" data-error-for="dugout_experience" hidden></p>
    </div>
  </div>

  <div class="reviews-form__prose">
    <div class="reviews-form__field">
      <textarea name="prose_1" rows="4" placeholder="How did getting it feel?" data-reviews-required data-prose-key="getting_it" data-prose-label="How did getting it feel?"></textarea>
      <p class="reviews-form__error" data-error-for="prose_1" hidden></p>
    </div>
    <div class="reviews-form__field">
      <textarea name="prose_2" rows="4" placeholder="How was the gift process for you?" data-prose-key="gift_process" data-prose-label="How was the gift process for you?"></textarea>
    </div>
    <div class="reviews-form__field">
      <textarea name="prose_3" rows="4" placeholder="Anything else? What it's been like to carry, what it means to you — or whatever else feels worth sharing. (Optional)" data-prose-key="anything_else" data-prose-label="Anything else?"></textarea>
    </div>
  </div>
{%- endcapture -%}

{% render 'review-form-shell', form_type: 'recipient', p1: p1, p2: p2, form_fields: form_fields %}

{% schema %}
{
  "name": "Review form — recipient",
  "tag": "section",
  "class": "reviews-section-form-recipient",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "select", "id": "section_width", "label": "t:settings.section_width", "default": "page-width", "options": [
      { "value": "page-width", "label": "Page width" },
      { "value": "full-width", "label": "Full width" }
    ]},
    { "type": "range", "id": "padding-block-start", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding-block-end", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "presets": [{ "name": "Review form — recipient" }]
}
{% endschema %}
