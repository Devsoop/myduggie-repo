{{ 'reviews-components.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reviews_data = shop.metafields.custom.reviews.value
  assign caption_prefix = section.settings.caption_prefix

  assign average = 0
  assign total_count = 0
  assign count_5 = 0
  assign count_4 = 0
  assign count_3 = 0
  assign count_2 = 0
  assign count_1 = 0
  assign rating_sum = 0

  assign display_filter = ''
  if reviews_data.buyer_display_ids != blank
    assign display_filter = reviews_data.buyer_display_ids | join: ','
  endif
  assign display_filter_padded = display_filter | prepend: ',' | append: ','
  assign show_all_buyers = false
  if display_filter == blank
    assign show_all_buyers = true
  endif

  if reviews_data.reviews != blank
    for review in reviews_data.reviews
      if review.reviewer_type != 'buyer'
        continue
      endif

      assign id_token = ',' | append: review.id | append: ','
      unless show_all_buyers or display_filter_padded contains id_token
        continue
      endunless

      assign r = review.rating | plus: 0
      assign rating_sum = rating_sum | plus: r
      assign total_count = total_count | plus: 1
      if r == 5
        assign count_5 = count_5 | plus: 1
      elsif r == 4
        assign count_4 = count_4 | plus: 1
      elsif r == 3
        assign count_3 = count_3 | plus: 1
      elsif r == 2
        assign count_2 = count_2 | plus: 1
      elsif r == 1
        assign count_1 = count_1 | plus: 1
      endif
    endfor

    if total_count > 0
      assign average = rating_sum | times: 100 | divided_by: total_count | times: 0.01
    endif
  endif

  if section.settings.average_override != blank
    assign average = section.settings.average_override | times: 1.0
  endif
-%}

<div class="reviews-surface reviews-surface--aggregate section-{{ section.id }}">
  <div class="reviews-surface__outer page-width">
    <div class="reviews-aggregate">
      {%- if reviews_data == blank or reviews_data.reviews == blank -%}
        <p class="reviews-test-page__intro">
          No reviews data. Paste <code>docs/decisions/reviews-sample.json</code> into
          <strong>Settings → Custom data → Shop → reviews</strong> (namespace <code>custom</code>, key <code>reviews</code>).
        </p>
      {%- elsif total_count == 0 -%}
        <p class="reviews-test-page__intro">No buyer reviews match <code>buyer_display_ids</code> in the shop metafield.</p>
      {%- else -%}
        {% render 'aggregate-rating-block',
          average: average,
          total_count: total_count,
          count_5: count_5,
          count_4: count_4,
          count_3: count_3,
          count_2: count_2,
          count_1: count_1,
          caption_prefix: caption_prefix,
          unique_id: section.id
        %}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Aggregate rating block",
  "tag": "section",
  "class": "reviews-section-aggregate",
  "settings": [
    {
      "type": "paragraph",
      "content": "Computed from the same buyer reviews shown on this page (buyer_display_ids in shop metafield custom.reviews)."
    },
    {
      "type": "text",
      "id": "average_override",
      "label": "Average override (acceptance test)",
      "info": "e.g. 4.3 to verify fractional star gradient. Leave blank for computed average."
    },
    {
      "type": "text",
      "id": "caption_prefix",
      "label": "Caption prefix",
      "default": "From"
    }
  ],
  "presets": [
    {
      "name": "Aggregate rating block"
    }
  ]
}
{% endschema %}
