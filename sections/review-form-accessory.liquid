{%- liquid
  assign p1 = "You bought it. You've used it, so you know what works and what could be better. Anyone considering one is the person you were a few weeks ago. Your story is what they need."
  assign p2 = "A few sentences if you have them, photos if you took any — about a minute. Reviews may have helped you decide, and now yours will help the next person decide. Thank you for taking the time."
-%}

{%- capture form_fields -%}
  <div class="reviews-form__field reviews-form__field--narrow">
    <label class="reviews-form__label" for="how_often-{{ section.id }}">How often you use it</label>
    <select id="how_often-{{ section.id }}" name="how_often" data-reviews-required>
      <option value="">Select…</option>
      <option value="Daily">Daily</option>
      <option value="Weekly">Weekly</option>
      <option value="Occasionally">Occasionally</option>
    </select>
    <p class="reviews-form__error" data-error-for="how_often" hidden></p>
  </div>

  <div class="reviews-form__prose">
    <div class="reviews-form__field">
      <textarea name="prose_1" rows="6" placeholder="Why you chose it. How you use it. Or whatever else feels worth sharing." data-reviews-required data-prose-key="combined" data-prose-label="Why you chose it. How you use it. Or whatever else feels worth sharing."></textarea>
      <p class="reviews-form__error" data-error-for="prose_1" hidden></p>
    </div>
  </div>
{%- endcapture -%}

{% render 'review-form-shell', form_type: 'accessory', p1: p1, p2: p2, form_fields: form_fields %}

{% schema %}
{
  "name": "Review form — accessory",
  "tag": "section",
  "class": "reviews-section-form-accessory",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "select", "id": "section_width", "label": "t:settings.section_width", "default": "page-width", "options": [
      { "value": "page-width", "label": "Page width" },
      { "value": "full-width", "label": "Full width" }
    ]},
    { "type": "range", "id": "padding-block-start", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding-block-end", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "presets": [{ "name": "Review form — accessory" }]
}
{% endschema %}
