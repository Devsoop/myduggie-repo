{%- comment -%} M1 revision #8: display_label for card; label = full form prompt (see reviews-sample.json). {%- endcomment -%}
{{ 'reviews-components.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reviews_data = shop.metafields.custom.reviews.value
  assign verified_buyer_label = section.settings.verified_buyer_label
  assign sample_label = section.settings.sample_label
  assign returns_label = section.settings.returns_label
  assign photo_limit = section.settings.photo_limit

  assign display_filter = ''
  if reviews_data.buyer_display_ids != blank
    assign display_filter = reviews_data.buyer_display_ids | join: ','
  endif
  assign display_filter_padded = display_filter | prepend: ',' | append: ','
  assign show_all_buyers = false
  if display_filter == blank
    assign show_all_buyers = true
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style reviews-surface reviews-surface--buyer-cards section-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
    {%- if section.settings.heading != blank -%}
      <h2 class="reviews-test-page__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="reviews-test-page__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    {%- if reviews_data == blank or reviews_data.reviews == blank -%}
      <p class="reviews-test-page__intro">
        No reviews data. Paste <code>docs/decisions/reviews-sample.json</code> into
        <strong>Settings → Custom data → Shop → reviews</strong> (namespace <code>custom</code>, key <code>reviews</code>).
      </p>
    {%- else -%}
      <div class="reviews-cards">
        {%- for review in reviews_data.reviews -%}
          {%- if review.reviewer_type != 'buyer' -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign id_token = ',' | append: review.id | append: ',' -%}
          {%- unless show_all_buyers or display_filter_padded contains id_token -%}
            {%- continue -%}
          {%- endunless -%}

          {%- liquid
            assign review_id = review.id
            assign rating = review.rating
            assign reviewer_first = review.reviewer_name.first
            assign reviewer_last = review.reviewer_name.last
            assign submitted_at = review.submitted_at
            assign order_returned = review.order_returned
            assign is_sample = review.is_sample
            assign how_often = review.answers.how_often
            assign where_it_lives = review.answers.where_it_lives
            assign dugout_experience = review.answers.dugout_experience

            assign prose_1_label = ''
            assign prose_1_body = ''
            assign prose_2_label = ''
            assign prose_2_body = ''
            assign prose_3_label = ''
            assign prose_3_body = ''

            if review.answers.prose != blank
              for prose_item in review.answers.prose
                if forloop.index == 1
                  assign prose_1_label = prose_item.display_label | default: prose_item.label
                  assign prose_1_body = prose_item.body
                elsif forloop.index == 2
                  assign prose_2_label = prose_item.display_label | default: prose_item.label
                  assign prose_2_body = prose_item.body
                elsif forloop.index == 3
                  assign prose_3_label = prose_item.display_label | default: prose_item.label
                  assign prose_3_body = prose_item.body
                endif
              endfor
            endif

            assign photo_count = review.photos | size | default: 0
            assign photo_1_url = ''
            assign photo_1_alt = ''
            assign photo_2_url = ''
            assign photo_2_alt = ''
            for photo in review.photos
              if forloop.index == 1
                assign photo_1_url = photo.url
                assign photo_1_alt = photo.alt
              elsif forloop.index == 2
                assign photo_2_url = photo.url
                assign photo_2_alt = photo.alt
              endif
            endfor
          -%}

          {%- liquid
            assign owns_count = review.owns | size | default: 0
            assign own_1_icon_type = ''
            assign own_1_color_hex = ''
            assign own_2_icon_type = ''
            assign own_2_color_hex = ''
            assign own_3_icon_type = ''
            assign own_3_color_hex = ''
          -%}
          {%- for own in review.owns -%}
            {%- if forloop.index == 1 -%}
              {%- assign own_1_icon_type = own.icon_type -%}
            {%- elsif forloop.index == 2 -%}
              {%- assign own_2_icon_type = own.icon_type -%}
            {%- elsif forloop.index == 3 -%}
              {%- assign own_3_icon_type = own.icon_type -%}
            {%- endif -%}
          {%- endfor -%}
          {%- for owns_color in review.owns_colors -%}
            {%- if forloop.index == 1 -%}
              {%- assign own_1_color_hex = owns_color.color_hex -%}
            {%- elsif forloop.index == 2 -%}
              {%- assign own_2_color_hex = owns_color.color_hex -%}
            {%- elsif forloop.index == 3 -%}
              {%- assign own_3_color_hex = owns_color.color_hex -%}
            {%- endif -%}
          {%- endfor -%}

          {% render 'review-card-buyer',
            review_id: review_id,
            rating: rating,
            reviewer_first: reviewer_first,
            reviewer_last: reviewer_last,
            submitted_at: submitted_at,
            order_returned: order_returned,
            is_sample: is_sample,
            how_often: how_often,
            where_it_lives: where_it_lives,
            dugout_experience: dugout_experience,
            photo_count: photo_count,
            owns_count: owns_count,
            prose_1_label: prose_1_label,
            prose_1_body: prose_1_body,
            prose_2_label: prose_2_label,
            prose_2_body: prose_2_body,
            prose_3_label: prose_3_label,
            prose_3_body: prose_3_body,
            photo_1_url: photo_1_url,
            photo_1_alt: photo_1_alt,
            photo_2_url: photo_2_url,
            photo_2_alt: photo_2_alt,
            own_1_icon_type: own_1_icon_type,
            own_1_color_hex: own_1_color_hex,
            own_2_icon_type: own_2_icon_type,
            own_2_color_hex: own_2_color_hex,
            own_3_icon_type: own_3_icon_type,
            own_3_color_hex: own_3_color_hex,
            verified_buyer_label: verified_buyer_label,
            sample_label: sample_label,
            returns_label: returns_label,
            photo_limit: photo_limit
          %}
        {%- endfor -%}
      </div>
    {%- endif -%}
</div>

<script>
  document.querySelectorAll('[data-reviews-lightbox-stub]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      /* Milestone 1: lightbox library deferred */
    });
  });
</script>

{% schema %}
{
  "name": "Buyer review cards",
  "tag": "section",
  "class": "reviews-section-buyer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "paragraph",
      "content": "Reads shop metafield custom.reviews (JSON). Owns row pairs review.owns (icon_type) with review.owns_colors (color_hex) by index per §4.1."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buyer reviews"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Milestone 1 test — §5.6 Buyer Review Card. Data from shop metafield custom.reviews."
    },
    {
      "type": "text",
      "id": "verified_buyer_label",
      "label": "Verified buyer tag",
      "default": "✓ Verified buyer"
    },
    {
      "type": "text",
      "id": "sample_label",
      "label": "Sample tag",
      "default": "Sample"
    },
    {
      "type": "text",
      "id": "returns_label",
      "label": "Returns badge",
      "default": "Order returned"
    },
    {
      "type": "range",
      "id": "photo_limit",
      "label": "Photo limit per review",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Buyer review cards"
    }
  ]
}
{% endschema %}
