{%- doc -%}
  Shared review form shell — §4.3 / §5.1–5.4.
  @param form_type - buyer | recipient | gifter | accessory
  @param p1 - locked intro paragraph 1
  @param p2 - locked intro paragraph 2
{%- enddoc -%}

{{ 'reviews-components.css' | asset_url | stylesheet_tag }}
<script src="{{ 'reviews-form.js' | asset_url }}" defer></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style reviews-surface reviews-surface--form section-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="reviews-form-page">
    <form
      class="reviews-form"
      data-reviews-form
      data-form-type="{{ form_type }}"
      novalidate
    >
      <div class="reviews-form__intro">
        <p class="reviews-form__p1">{{ p1 }}</p>
        <p class="reviews-form__p2">{{ p2 }}</p>
      </div>

      <hr class="reviews-form__divider">

      <div class="reviews-form__field">
        <label class="reviews-form__label">Your rating</label>
        <div class="reviews-form__stars" data-reviews-stars role="radiogroup" aria-label="Star rating">
          {%- for i in (1..5) -%}
            <button type="button" class="reviews-form__star" data-star-value="{{ i }}" aria-label="{{ i }} out of 5 stars">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </button>
          {%- endfor -%}
        </div>
        <input type="hidden" name="rating" data-reviews-rating-input value="">
        <p class="reviews-form__error" data-error-for="rating" hidden></p>
      </div>

      <div class="reviews-form__context" data-reviews-context hidden>
        <p class="reviews-form__context-label">Your order</p>
        <ul class="reviews-form__owns-list" data-reviews-owns-list></ul>
      </div>

      {{ form_fields }}

      <div class="reviews-form__field">
        <div class="reviews-form__photo-zone" data-reviews-photo-zone>
          <input type="file" accept="image/*" multiple hidden data-reviews-photo-input>
          <button type="button" class="reviews-form__photo-trigger" data-reviews-photo-trigger>
            <span class="reviews-form__photo-icon" aria-hidden="true">+</span>
            <span class="reviews-form__photo-text">Add photos</span>
            <span class="reviews-form__photo-caption">Optional, up to 4</span>
          </button>
          <div class="reviews-form__photo-previews" data-reviews-photo-previews></div>
        </div>
        <p class="reviews-form__error" data-error-for="photos" hidden></p>
      </div>

      <p class="reviews-form__error reviews-form__error--global" data-reviews-global-error hidden></p>

      <button type="submit" class="reviews-form__submit" data-reviews-submit disabled>
        Submit review
      </button>
    </form>
  </div>
</div>
