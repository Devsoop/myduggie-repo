{%- doc -%}
  Map product handle to M1 icon_type for Owns row when using metaobject product references.
  @param {string} handle - Product handle
  @returns {string} icon_type via echo
{%- enddoc -%}

{%- liquid
  assign icon_type = 'duggie'
  case handle
    when 'the-none-better-keychain'
      assign icon_type = 'keychain'
    when 'the-none-better-pipe', 'pipe'
      assign icon_type = 'pipe'
    when 'the-lil-duggie', 'the-lil-duggie-2'
      assign icon_type = 'duggie'
  endcase
-%}
{{- icon_type -}}
